# Bore & Barrel — Environment Variables
# Salin file ini ke .env dan isi nilainya.

# Base URL Supabase REST API individu
# Format: https://<project-ref>.supabase.co/rest/v1
VITE_API_BASE_URL=

# Supabase Publishable Key (API Key individu)
# Ditemukan di: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_PUBLISHABLE_KEY=
